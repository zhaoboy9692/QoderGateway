# QoderGateway 环境变量示例 / Environment example
# 复制为 .env 或在 shell 中设置变量。 / Copy to .env or set variables in your shell.

# 服务监听地址与端口 / Server bind address and port
QODER_HOST=127.0.0.1
QODER_PORT=5050

# 管理控制台密码 / Administrator password for the management console.
# 设置后覆盖 SQLite 保存的管理密钥。 / Overrides the SQLite gateway token when set.
QODER_ADMIN_PASSWORD=admin

# 可选的 Qoder 上游显式代理 / Optional explicit proxy for supported Qoder request paths.
# 示例 / Example: http://127.0.0.1:7890
QODER_PROXY=

# 启用或禁用公开静态页面 / Enable or disable public static pages.
# 设为 0 / false / no / off 禁用。 / Set to 0 / false / no / off to disable.
QODER_ENABLE_DOCUMENTS=1
QODER_ENABLE_LANDING=1

# 无账号时启动自动导入的可选 PAT / Optional PAT imported at startup if no accounts exist.
QODER_PAT=

# 私有模型目录的绝对路径 / Absolute path to a private model catalog.
QODER_MODEL_CATALOG_PATH=
